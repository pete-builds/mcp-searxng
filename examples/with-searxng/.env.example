# Copy to .env, chmod 600 .env, and fill both in. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Bearer token every MCP client must send as "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=

# SearXNG's own session secret. Any long random string.
SEARXNG_SECRET=
