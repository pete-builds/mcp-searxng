# SearXNG instance URL (no trailing slash)
SEARXNG_URL=http://your-searxng-host:8888

# Bearer token. REQUIRED for the HTTP transport, which is the default and what
# the container runs. The server refuses to start without it, and every client
# must send it as "Authorization: Bearer <token>".
#
# Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The real value lives only in .env on the host (chmod 600 .env). Never put it
# in a compose file and never commit it.
MCP_AUTH_TOKEN=
